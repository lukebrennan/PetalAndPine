---
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';
import { path } from '../lib/paths';
const active = (slug: string) => Astro.url.pathname.startsWith(path(slug));
const briefHref = `${path('contact')}#flower-brief`;
---
<div class="header-shell">
  <header class="site-header wrap">
    <a class="wordmark" href={path()} aria-label="Petal and Pine, home">{site.name}<small>{site.tagline}</small></a>
    <nav class="desktop-nav" aria-label="Main">
      {navigation.map((item) => <a href={path(item.slug)} aria-current={active(item.slug) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="button header-cta" href={briefHref}>Plan a bouquet</a>
    <details class="mobile-nav">
      <summary>Menu <Icon kind="menu" /></summary>
      <nav class="mobile-panel" aria-label="Main">
        <a href={path()} aria-current={Astro.url.pathname === path() ? 'page' : undefined}>Home <Icon /></a>
        {navigation.map((item) => <a href={path(item.slug)} aria-current={active(item.slug) ? 'page' : undefined}>{item.label} <Icon /></a>)}
        <a class="button" href={briefHref}>Plan a bouquet</a>
      </nav>
    </details>
  </header>
</div>
