---
import Icon from './Icon.astro';
import { path } from '../lib/paths';
interface Props { title?: string; text?: string }
const { title = 'Tell us who it’s for.', text = 'Pick a palette, choose a size, add the date, and send us the brief. We will confirm the price before anything is made.' } = Astro.props;
---
<section class="contact-cta wrap section-space">
  <Icon kind="flower" class="contact-star" /><p class="eyebrow">Get in touch</p><h2>{title}</h2><p>{text}</p><a class="button" href={`${path('contact')}#flower-brief`}>Create your flower brief <Icon /></a>
</section>
