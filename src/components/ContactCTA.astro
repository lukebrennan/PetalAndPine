---
import Icon from './Icon.astro';
import { path } from '../lib/paths';
interface Props { title?: string; text?: string }
const { title = 'Tell us who it’s for.', text = 'Pick a palette and a size, add the date and anything we should know, and send us the brief. We will confirm the price before anything is made.' } = Astro.props;
---
<section class="section rule">
  <div class="wrap cta">
    <div><h2>{title}</h2><p>{text}</p></div>
    <a class="button" href={`${path('contact')}#flower-brief`}>Plan a bouquet <Icon /></a>
  </div>
</section>
