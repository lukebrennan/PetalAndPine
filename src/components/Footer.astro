---
import { navigation, shop, site } from '../data/site';
import { path } from '../lib/paths';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div><a class="footer-brand" href={path()}>petal <i>&</i> pine</a><p class="footer-intro">A little wild. Always thoughtful.<br />Garden-inspired flowers and everyday beauty.</p></div>
    <div><h2 class="footer-heading">A little exploring</h2><nav class="footer-links" aria-label="Footer navigation">{navigation.map((item) => <a href={path(item.slug)}>{item.label}</a>)}</nav></div>
    <div><h2 class="footer-heading">Our Chester shop</h2><p>{shop.address.map((line) => <span class="address-line">{line}</span>)}</p><p class="footer-sample">Illustrative shop address</p><a class="text-link" href={path('contact')}>Plan a flower brief</a></div>
  </div>
  <div class="wrap footer-bottom"><small>© {new Date().getFullYear()} {site.name}</small><p>{shop.demoNote}</p></div>
</footer>
