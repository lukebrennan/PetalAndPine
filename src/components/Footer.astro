---
import { navigation, shop, site } from '../data/site';
import { path } from '../lib/paths';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div><a class="footer-brand" href={path()}>{site.name}</a><p>{site.tagline}. Loose, garden-style bouquets in three palettes, made up by hand on the day.</p></div>
    <div><h2 class="footer-heading">Pages</h2><nav class="footer-links" aria-label="Footer">{navigation.map((item) => <a href={path(item.slug)}>{item.label}</a>)}</nav></div>
    <div><h2 class="footer-heading">Find us</h2><p>{shop.address.map((line) => <span class="address-line">{line}</span>)}</p><p>{shop.hours[0].days}, {shop.hours[0].time}<br />{shop.hours[1].days}, {shop.hours[1].time}</p></div>
  </div>
  <div class="wrap footer-bottom"><small>© {new Date().getFullYear()} {site.name}</small>{shop.isDemo && <p>{shop.demoNote}</p>}</div>
</footer>
