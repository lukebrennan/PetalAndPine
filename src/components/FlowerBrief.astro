---
import Icon from './Icon.astro';
import { collections, occasions, sizes } from '../data/site';
---
<div class="brief">
  <form id="brief-form" class="brief-form" aria-label="Plan a bouquet">
    <div class="field"><label for="brief-name">Your name</label><input id="brief-name" name="name" type="text" autocomplete="given-name" maxlength="100" /></div>
    <div class="field"><label for="brief-occasion">Occasion</label><select id="brief-occasion" name="occasion"><option value="">Not sure yet</option>{occasions.map((occasion) => <option value={occasion.value}>{occasion.label}</option>)}<option value="other">Something else</option></select></div>
    <div class="field"><label for="brief-palette">Palette</label><select id="brief-palette" name="palette"><option value="">You choose</option>{collections.map((collection) => <option value={collection.slug}>{collection.name}</option>)}</select></div>
    <div class="field"><label for="brief-size">Size</label><select id="brief-size" name="size"><option value="">Not sure yet</option>{sizes.map((size) => <option value={size.value}>{size.label}</option>)}</select></div>
    <div class="field"><label for="brief-date">Date needed</label><input id="brief-date" name="date" type="date" /></div>
    <div class="field"><label for="brief-delivery">Collect or deliver</label><select id="brief-delivery" name="delivery"><option value="">Not sure yet</option><option value="collect">I’ll collect</option><option value="deliver">Deliver, please</option></select></div>
    <div class="field wide"><label for="brief-notes">Anything else <span>(colours, who it’s for, a card message, postcode)</span></label><textarea id="brief-notes" name="notes" rows="4" maxlength="1200"></textarea></div>
    <div class="wide form-note"><p>The form writes the message on the right. Copy it and send it to us; nothing is sent from this page.</p><button type="reset" class="link">Clear the form</button></div>
  </form>
  <div class="brief-preview"><h2>Your brief</h2><label class="visually-hidden" for="brief-output">Your brief, ready to copy</label><textarea id="brief-output" rows="14" readonly></textarea><button id="copy-brief" type="button" class="button">Copy the brief <Icon /></button><p id="brief-status" role="status" aria-live="polite"></p><noscript><p>Turn on JavaScript to have the brief written for you, or write your own message from the questions on the left.</p></noscript></div>
</div>
<script define:vars={{ prices: Object.fromEntries(collections.map((c) => [c.slug, c.price])), extras: Object.fromEntries(sizes.map((s) => [s.value, s.extra])) }}>
  const form = document.querySelector('#brief-form');
  const output = document.querySelector('#brief-output');
  const button = document.querySelector('#copy-brief');
  const status = document.querySelector('#brief-status');
  if (form && output && button) {
    const query = new URLSearchParams(window.location.search);
    ['palette', 'size', 'occasion'].forEach((field) => {
      const select = form.elements.namedItem(field);
      const requested = query.get(field);
      if (select instanceof HTMLSelectElement && requested && [...select.options].some((option) => option.value === requested)) select.value = requested;
    });
    const selectedText = (name) => {
      const select = form.elements.namedItem(name);
      return select instanceof HTMLSelectElement && select.value ? select.selectedOptions[0].textContent?.trim() ?? '' : '';
    };
    const gbp = (n) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 0 }).format(n);
    const update = () => {
      const fields = new FormData(form);
      const get = (name) => String(fields.get(name) ?? '').trim();
      const palette = get('palette');
      const size = get('size');
      const lines = ['Hello Petal & Pine,', ''];
      const what = [selectedText('size').toLowerCase(), palette ? `in ${selectedText('palette')}` : ''].filter(Boolean).join(' ');
      lines.push(what ? `I’d like a ${what}${get('occasion') ? ` for a ${selectedText('occasion').toLowerCase()}` : ''}.` : `I’d like some flowers${get('occasion') ? ` for a ${selectedText('occasion').toLowerCase()}` : ''}, but I’m not sure what yet.`);
      if (palette && size) lines.push(`I think that’s ${gbp(prices[palette] + extras[size])} from your website.`);
      if (get('date')) {
        const [year, month, day] = get('date').split('-').map(Number);
        lines.push(`I need them on ${new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(year, month - 1, day))}.`);
      }
      if (get('delivery') === 'collect') lines.push('I’ll collect from the shop.');
      if (get('delivery') === 'deliver') lines.push('Could you deliver, please? Postcode below.');
      if (get('notes')) lines.push('', get('notes'));
      lines.push('', 'Thanks,', get('name'));
      output.value = lines.join('\n').trimEnd();
      if (status) status.textContent = '';
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', () => setTimeout(update, 0));
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        if (status) status.textContent = 'Copied. Paste it into an email or a message to us.';
      } catch {
        output.focus(); output.select();
        if (status) status.textContent = 'The text is selected; copy it with your keyboard.';
      }
    });
    update();
  }
</script>
