---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import care from '../assets/care.png';
import { careFAQs } from '../data/site';
const steps = [
  { title: 'Start with a clean vase', text: 'Wash it properly; bacteria in an old vase is the main reason flowers go over early. Strip any leaves that would sit under the water.' },
  { title: 'Cut the stems', text: 'Take 1–2cm off each stem at an angle with sharp scissors or a knife, then get them straight into water.' },
  { title: 'Use the flower food', text: 'If there is a sachet in the wrap, use it as the packet says. If not, plain cold water is fine. Keep an eye on the level; a big bouquet drinks more than you expect.' },
  { title: 'Keep them cool', text: 'Out of direct sun, away from radiators, and not next to the fruit bowl. A cool hallway beats a sunny windowsill.' },
  { title: 'Change the water', text: 'Every two days, with a fresh cut on the stems. Pull out anything that has gone over so it does not take the rest with it.' },
];
---
<Layout title="Flower care guide — Petal & Pine" description="Simple, practical tips for cut flowers: clean vases, fresh stem cuts, water changes, cool positions, and common flower-care questions." image={care}>
  <section class="inner-hero wrap"><div><p class="eyebrow">Flower care</p><h1>Looking after your flowers</h1><p class="page-lead">Five things that make the difference between four days and ten. None of them takes more than a minute.</p><a class="text-link" href="#care-steps">The five steps</a></div><div class="inner-hero-photo"><Image src={care} alt="Fresh flowers in clean water beside floral shears and an ivory linen cloth." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <section id="care-steps" class="wrap section-space care-guide"><div class="care-guide-intro"><p class="eyebrow">When they arrive</p><h2>Five steps</h2><p class="body-copy">These are for a mixed bouquet. Some stems last longer than others; that is normal, not a fault.</p></div><ol class="care-steps">{steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>
  <section class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">At a glance</p><h2>The routine</h2></div></div><div class="care-table"><div><strong>When they arrive</strong><span>Clean vase, trimmed stems, fresh water.</span></div><div><strong>Each day</strong><span>Check the water level and remove tired petals or stems.</span></div><div><strong>Every day or two</strong><span>Change the water and refresh the cut ends.</span></div><div><strong>Whenever you move them</strong><span>Choose a cool spot, away from heat, direct sun, and fruit.</span></div></div></div></section>
  <section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">Particular stems</p><h2>A few that need their own notes</h2></div></div><div class="three-up"><article><h3>Garden roses</h3><p>The outer petals are often a bit scruffy; that is how they grow. Pull off any that have gone brown and leave the rest.</p></article><article><h3>Tulips</h3><p>They keep growing in the vase and lean towards the window. Give them a tall vase and let them do it.</p></article><article><h3>Mixed garden bunches</h3><p>Some stems go over before others. As they do, regroup what is left into a smaller vase; it will often go another few days.</p></article></div></section>
  <section class="wrap section-space faq-section"><div><p class="eyebrow">Questions</p><h2>Common questions</h2></div><FAQ items={careFAQs} /></section>
  <ContactCTA />
</Layout>
