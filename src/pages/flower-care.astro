---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import care from '../assets/care.png';
import { careFAQs } from '../data/site';
const steps = [
  { title: 'Start with a clean vase', text: 'Wash it properly. Bacteria in an old vase is the main reason flowers go over early. Strip any leaves that would sit under the water.' },
  { title: 'Cut the stems', text: 'Take 2cm off each stem at an angle with sharp scissors or a knife, then get them straight into water.' },
  { title: 'Use the flower food', text: 'If there is a sachet in the wrap, use it as the packet says. If not, plain cold water is fine. Do not add sugar, bleach or aspirin.' },
  { title: 'Keep them cool', text: 'Out of direct sun, away from radiators, and not next to the fruit bowl. A cool hallway beats a sunny windowsill.' },
  { title: 'Change the water', text: 'Every two days, with a fresh cut on the stems. Pull out anything that has gone over so it does not take the rest with it.' },
];
---
<Layout title="Flower care — Petal & Pine, Chester" description="How to keep a bouquet going: clean vase, fresh cut, flower food, somewhere cool, and fresh water every couple of days." image={care}>
  <section class="inner-hero"><div class="hero-copy"><h1>Flower care</h1><p class="lead">Five things that make the difference between four days and ten. None of them take more than a minute.</p></div><div class="hero-photo"><Image src={care} alt="Pink and cream flowers in a glass vase of clean water, beside shears and a linen cloth." widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /></div></section>

  <section id="care-steps" class="wrap section care" aria-labelledby="steps-title">
    <div class="care-intro stack"><h2 id="steps-title">When they arrive</h2><p>These are for a mixed bouquet. Some stems last longer than others; that is normal, not a fault.</p></div>
    <ol class="care-steps">{steps.map((step) => <li><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
  </section>

  <section class="green band" aria-labelledby="stems-title">
    <div class="wrap">
      <div class="band-head"><h2 id="stems-title">A few stems that need their own notes</h2></div>
      <div class="labels">
        <div class="label"><span class="label-name">Garden roses</span><p>The outer petals are often a bit scruffy; that is how they grow. Pull off any that have gone brown and leave the rest.</p></div>
        <div class="label"><span class="label-name">Tulips</span><p>They keep growing in the vase and lean towards the window. Give them a tall vase and let them do it.</p></div>
        <div class="label"><span class="label-name">Dahlias</span><p>Big drinkers with a short life. Top the water up daily and expect four or five days, not ten.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section faq-section" aria-labelledby="faq-title"><div class="stack"><h2 id="faq-title">Questions</h2></div><FAQ items={careFAQs} /></section>
  <ContactCTA />
</Layout>
