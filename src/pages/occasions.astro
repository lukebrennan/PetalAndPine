---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CopyText from '../components/CopyText.astro';
import occasionImage from '../assets/occasion.png';
import { occasions, collections } from '../data/site';
import { path } from '../lib/paths';
---
<Layout title="Flowers for every occasion — Petal & Pine" description="Birthday colour, thoughtful thank-yous, just-because flowers, and wedding inspiration. Find a palette and a message for your moment." image={occasionImage}>
  <section class="inner-hero wrap"><div><p class="eyebrow">Occasions</p><h1>Flowers for the occasion</h1><p class="page-lead">What we usually suggest for each one, and a line for the card if you are stuck for words.</p><a class="text-link" href="#occasion-ideas">Find your occasion</a></div><div class="inner-hero-photo"><Image src={occasionImage} alt="Garden-inspired flower arrangements on a relaxed celebration table with cream linen and glassware." widths={[640, 960, 1440]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <div class="wrap occasion-jump-links">{occasions.map((occasion) => <a href={`#${occasion.value}`}>{occasion.label}</a>)}</div>
  <div id="occasion-ideas" class="wrap occasion-stories">
    {occasions.map((occasion, index) => {
      const collection = collections.find((item) => item.slug === occasion.collection)!;
      return <section id={occasion.value} class:list={['occasion-story', index % 2 === 1 && 'reverse']}><div class="occasion-story-image"><Image src={occasion.value === 'wedding' ? occasionImage : collection.image} alt={occasion.value === 'wedding' ? 'Soft floral centrepieces on an intimate celebration table.' : collection.alt} widths={[480, 720, 960]} sizes="(max-width: 760px) 92vw, 42vw" format="webp" quality={80} loading="lazy" /></div><div><p class="eyebrow">0{index + 1} · {occasion.label}</p><h2>{occasion.title}</h2><p class="body-copy">{occasion.description}</p><p class="palette-tip">{occasion.idea}</p><div class="message-card"><p class="eyebrow">For the card</p><blockquote>{occasion.message}</blockquote><CopyText text={occasion.message} /></div><div class="occasion-actions"><a class="text-link" href={path(`flowers/${collection.slug}`)}>See {collection.name.toLowerCase()} <Icon /></a><a class="text-link" href={`${path('contact')}?occasion=${occasion.value}#flower-brief`}>Plan this one <Icon /></a></div></div></section>;
    })}
  </div>
  <ContactCTA title="Something else?" text="Anniversaries, apologies, leaving dos. Tell us what it is and we will suggest a palette." />
</Layout>
