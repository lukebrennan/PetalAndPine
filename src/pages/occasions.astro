---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CopyText from '../components/CopyText.astro';
import occasionImage from '../assets/occasion.png';
import { occasions, collections } from '../data/site';
import { path } from '../lib/paths';
---
<Layout title="Occasions — Petal & Pine, Chester" description="Which bouquet for a birthday, a thank-you, a new home, sympathy or a wedding, with a card message you can copy." image={occasionImage}>
  <section class="inner-hero"><div class="hero-copy"><h1>Occasions</h1><p class="lead">What we usually suggest, and a line for the card if you are stuck for words.</p></div><div class="hero-photo"><Image src={occasionImage} alt="Loose garden-style arrangements along a long table laid with linen and glassware." widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <nav class="wrap jump-links" aria-label="Occasions on this page">{occasions.map((occasion) => <a href={`#${occasion.value}`}>{occasion.title}</a>)}</nav>
  <div class="wrap">
    {occasions.map((occasion, index) => {
      const collection = collections.find((item) => item.slug === occasion.collection)!;
      const wedding = occasion.value === 'wedding';
      return <section id={occasion.value} class:list={['occasion', index % 2 === 1 && 'reverse']} aria-labelledby={`${occasion.value}-title`}>
        <div class="photo"><Image src={wedding ? occasionImage : collection.image} alt={wedding ? 'Table arrangements for a wedding.' : collection.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 42vw" format="webp" quality={80} loading="lazy" /></div>
        <div>
          <h2 id={`${occasion.value}-title`}>{occasion.title}</h2>
          <p style="margin-top: 16px">{occasion.description}</p>
          <p class="suggest">{occasion.idea}</p>
          <div class="card-message"><p class="small">For the card</p><blockquote>{occasion.message}</blockquote><CopyText text={occasion.message} /></div>
          <div class="actions" style="margin-top: 22px"><a class="button" href={`${path('contact')}?occasion=${occasion.value}&palette=${collection.slug}#flower-brief`}>Plan this one <Icon /></a><a class="link" href={path(`flowers/${collection.slug}`)}>See {collection.name}</a></div>
        </div>
      </section>;
    })}
  </div>
  <ContactCTA title="Something else?" text="Anniversaries, apologies, leaving dos, the dog’s birthday. Tell us what it is and we will suggest a palette." />
</Layout>
