---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import studio from '../assets/studio.png';
import wild from '../assets/wild.png';
import { shop, site } from '../data/site';
import { path } from '../lib/paths';
---
<Layout title="About — Petal & Pine, Chester" description="Petal & Pine is a small independent florist in Chester making loose, garden-style bouquets by hand." image={studio}>
  <section class="inner-hero"><div class="hero-copy"><h1>About the shop</h1><p class="lead">{site.story}</p></div><div class="hero-photo"><Image src={studio} alt="The workbench in the shop: jugs of roses, ranunculus and foliage, ribbon, paper and shears." widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /></div></section>

  <section class="wrap section" aria-labelledby="how-title">
    <h2 id="how-title">How we work</h2>
    <div class="columns prose">
      <div><p>We buy from the Chester wholesale market twice a week and from a couple of growers in Cheshire and North Wales in the summer. What we have changes with the season, which is why we sell by palette rather than by a fixed list of flowers.</p><p>Everything is made up on the day it goes out. We do not keep made-up bouquets in a chiller waiting for someone to buy them.</p></div>
      <div><p>We wrap in paper and tie with ribbon. No cellophane, no floral foam, no plastic sleeves. If you want a vase or a jug with it, say so in the brief and we will find one that suits.</p><p>If what you have asked for is not in season or not good that week, we will say so and suggest something that is.</p></div>
    </div>
  </section>

  <section class="green band" aria-labelledby="believe-title">
    <div class="wrap">
      <h2 id="believe-title" style="margin-bottom: 24px">Three things we stick to</h2>
      <div class="labels">
        <div class="label"><span class="label-name">The person first</span><p>Tell us who it is for and what they are like. That tells us more than a flower name does.</p></div>
        <div class="label"><span class="label-name">Loose, not stiff</span><p>Stems with room to move, foliage mixed through, nothing wired or forced into a dome.</p></div>
        <div class="label"><span class="label-name">Honest about the season</span><p>Peonies in May, dahlias in September. We will not fly in something tired to hit a request.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section split" aria-labelledby="visit-title">
    <div class="photo"><Image src={wild} alt="White cosmos and garden roses in a green vase on the shop counter." widths={[640, 960]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="lazy" /></div>
    <div class="stack"><h2 id="visit-title">Come in</h2><p>We are at {shop.address.join(', ')}, open {shop.hours[0].days} {shop.hours[0].time} and {shop.hours[1].days} {shop.hours[1].time}. There are usually buckets outside if you just want a bunch of something.</p><div class="actions"><a class="link" href={path('contact')}>Opening hours and directions <Icon /></a></div></div>
  </section>
  <ContactCTA />
</Layout>
