---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import studio from '../assets/studio.png';
import wild from '../assets/wild.png';
import { shop } from '../data/site';
import { path } from '../lib/paths';
---
<Layout title="Our story — Petal & Pine" description="Petal & Pine is a small independent florist in Chester making loose, garden-style bouquets by hand." image={studio}>
  <section class="inner-hero wrap"><div><p class="eyebrow">Our story</p><h1>About the shop</h1><p class="page-lead">A small florist in Chester making loose, garden-style bouquets by hand, with whatever is good that week.</p></div><div class="inner-hero-photo"><Image src={studio} alt="Illustrative florist studio scene with loose flowers, linen ribbon, wrapping paper, and floral tools." widths={[640, 960, 1440]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <section class="wrap section-space story-introduction"><p class="eyebrow">How we work</p><h2>Garden-style, not formal</h2><div class="story-columns"><p>We buy from the wholesale market twice a week and from a couple of local growers in summer, so what we have changes with the season. That is why we sell by palette rather than by a fixed list of flowers.</p><p>Our bouquets are loose on purpose: stems with room to move, foliage mixed through, nothing wired or forced into a dome. Everything is made up on the day it goes out, wrapped in paper and tied with ribbon.</p></div></section>
  <section class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">What we stick to</p><h2>Three things</h2></div></div><div class="three-up"><article><Icon kind="flower" class="value-icon" /><h3>The person first</h3><p>Tell us who it is for and what they are like. That tells us more than a flower name does.</p></article><article><Icon kind="flower" class="value-icon" /><h3>Loose, not stiff</h3><p>Layered foliage and flowers with room to breathe, the way things grow in a garden.</p></article><article><Icon kind="flower" class="value-icon" /><h3>Honest about the season</h3><p>Peonies in May, dahlias in September. If what you ask for is not good that week, we will say so and suggest something that is.</p></article></div></div></section>
  <section class="wrap section-space split-section"><div class="editorial-photo arch"><Image src={wild} alt="Loosely gathered white flowers and greenery in a simple ceramic vase." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="lazy" /></div><div><p class="eyebrow">The shop</p><h2>Come in</h2><p class="body-copy">We are at {shop.address.join(', ')}. There are usually buckets outside if you just want a bunch of something, and we are happy to make something up while you wait.</p><p class="body-copy">Opening hours, delivery and how to get in touch are on the contact page.</p><a class="text-link" href={path('contact')}>Hours and directions <Icon /></a></div></section>
  <ContactCTA />
</Layout>
