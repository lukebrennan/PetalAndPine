---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { collections, sizes, type Collection } from '../../data/site';
import { path, price } from '../../lib/paths';
export function getStaticPaths() { return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } })); }
interface Props { collection: Collection }
const { collection } = Astro.props;
const briefHref = (size?: string) => `${path('contact')}?palette=${collection.slug}${size ? `&size=${size}` : ''}#flower-brief`;
---
<Layout title={`${collection.name} bouquets — Petal & Pine, Chester`} description={`${collection.description} Posies from ${price(collection.price)}, bouquets from ${price(collection.price + 15)}. Plan one online.`} image={collection.image}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={path()}>Home</a><span aria-hidden="true">/</span><a href={path('flowers')}>Bouquets</a><span aria-hidden="true">/</span><span aria-current="page">{collection.name}</span></nav></div>
  <section class="wrap product">
    <div class="photo"><Image src={collection.image} alt={collection.alt} widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 52vw" format="webp" quality={82} loading="eager" fetchpriority="high" /></div>
    <div class="product-copy stack">
      <h1>{collection.name}</h1>
      <p class="lead">{collection.story}</p>
      <p class="price">From {price(collection.price)} <span>for a posy</span></p>
      <div class="swatches" aria-label="Colours">{collection.colours.map((colour) => <div><span style={`--swatch: ${colour.hex}`} aria-hidden="true"></span>{colour.name}</div>)}</div>
      <div class="actions"><a class="button" href={briefHref()}>Plan this bouquet <Icon /></a></div>
      <p class="small muted">{collection.note}</p>
    </div>
  </section>

  <section class="green band" aria-labelledby="sizes-title">
    <div class="wrap">
      <div class="band-head"><h2 id="sizes-title">Sizes</h2><p>Pick one and the brief is filled in for you.</p></div>
      <div class="size-grid">{sizes.map((size) => <a class="label" href={briefHref(size.value)}><span class="label-name">{size.label}</span><span class="label-price"><strong>{price(collection.price + size.extra)}</strong></span><p>{size.description}</p><span class="label-go">Choose {size.label.toLowerCase()} <Icon /></span></a>)}</div>
    </div>
  </section>

  <section class="wrap section notes">
    <div class="stack"><h2>What goes in it</h2><p>{collection.stems}</p><p>{collection.feeling}</p></div>
    <div class="stack"><h2>Good for</h2><ul class="plain-list">{collection.moments.map((moment) => <li>{moment}</li>)}</ul><p><a class="link" href={path('flower-care')}>How to make them last <Icon /></a></p></div>
  </section>

  <section class="wrap section rule" aria-labelledby="others-title">
    <div class="band-head"><h2 id="others-title">The other two</h2><a class="link" href={path('flowers')}>All bouquets <Icon /></a></div>
    <div class="collection-grid two-cards">{collections.filter((other) => other.slug !== collection.slug).map((other) => <CollectionCard collection={other} />)}</div>
  </section>
</Layout>
