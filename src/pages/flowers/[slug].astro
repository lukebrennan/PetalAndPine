---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { collections, sizes, type Collection } from '../../data/site';
import { path, price } from '../../lib/paths';
export function getStaticPaths() { return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } })); }
interface Props { collection: Collection }
const { collection } = Astro.props;
---
<Layout title={`${collection.name} flowers — Petal & Pine`} description={`${collection.description} From ${price(collection.price)}. Plan one online.`} image={collection.image}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={path()}>Home</a><span aria-hidden="true">/</span><a href={path('flowers')}>Our flowers</a><span aria-hidden="true">/</span><span aria-current="page">{collection.name}</span></nav></div>
  <section class="product-hero wrap"><div class="product-photo"><Image src={collection.image} alt={collection.alt} widths={[640, 960, 1440]} sizes="(max-width: 760px) 92vw, 48vw" format="webp" quality={82} loading="eager" fetchpriority="high" /></div><div class="product-copy"><p class="eyebrow">Our flowers</p><h1>{collection.name}</h1><p class="page-lead">{collection.description}</p><p class="product-price">From {price(collection.price)} <span>small bouquet</span></p><p class="body-copy">{collection.story}</p><div class="swatches" aria-label="Palette colours">{collection.colours.map((colour) => <div><span style={`--swatch: ${colour.hex}`} aria-hidden="true"></span><small>{colour.name}</small></div>)}</div><a class="button" href={`${path('contact')}?palette=${collection.slug}#flower-brief`}>Plan this bouquet <Icon /></a><p class="section-note">The photo shows the palette and the style; the stems depend on the week.</p></div></section>
  <section class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">Sizes</p><h2>Choose a size</h2></div><p>Pick one and the brief is filled in for you.<br />We confirm the price before anything is made.</p></div><div class="size-grid">{sizes.map((size) => <a class="size-card" href={`${path('contact')}?palette=${collection.slug}&size=${size.value}#flower-brief`}><h3>{size.label}</h3><p>{size.description}</p><strong>{price(collection.price + size.extra)}</strong><span>Choose this size <Icon /></span></a>)}</div></div></section>
  <section class="wrap section-space product-notes"><article><p class="eyebrow">The palette</p><h2>What it feels like</h2><p>{collection.feeling}</p><p>{collection.note}</p></article><article><h3>Good for</h3><ul class="plain-list">{collection.moments.map((moment) => <li><Icon kind="flower" />{moment}</li>)}</ul><h3>What goes in it</h3><p>{collection.stems}</p><a class="text-link" href={path('flower-care')}>How to make them last <Icon /></a></article></section>
  <section class="wrap section-space related-section"><div class="section-heading"><div><p class="eyebrow">Our flowers</p><h2>The other two palettes</h2></div><a class="text-link" href={path('flowers')}>All our flowers <Icon /></a></div><div class="collection-grid two-cards">{collections.filter((other) => other.slug !== collection.slug).map((other, index) => <CollectionCard collection={other} index={index} />)}</div></section>
</Layout>
