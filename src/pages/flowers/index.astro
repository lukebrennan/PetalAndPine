---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FAQ from '../../components/FAQ.astro';
import wild from '../../assets/wild.png';
import { collections, sizes, flowerFAQs } from '../../data/site';
import { price } from '../../lib/paths';
---
<Layout title="Bouquets — Petal & Pine, Chester" description="Three palettes of loose, garden-style bouquets from Petal & Pine in Chester: Blush & cream, Peach & coral, and White & green. Posies from £30." image={wild}>
  <section class="inner-hero"><div class="hero-copy"><h1>Bouquets</h1><p class="lead">Three palettes, each in three sizes. Pick the colours you like; we pick the stems that are good that week.</p><div class="actions"><a class="link" href="#palettes">The palettes</a><a class="link" href="#sizes">Sizes and prices</a></div></div><div class="hero-photo"><Image src={wild} alt="White cosmos, cream roses and loose greenery in a green ceramic vase." widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /></div></section>

  <section id="palettes" class="wrap section" aria-labelledby="palettes-title">
    <h2 id="palettes-title" style="margin-bottom: 24px">The palettes</h2>
    <div class="filters" role="group" aria-label="Show a palette"><button type="button" class="filter" data-filter="all" aria-pressed="true">All three</button>{collections.map((collection) => <button type="button" class="filter" data-filter={collection.palette} aria-pressed="false">{collection.name}</button>)}</div>
    <p class="filter-status" role="status" aria-live="polite">Showing all three palettes.</p>
    <div class="collection-grid" data-collection-grid>{collections.map((collection) => <CollectionCard collection={collection} />)}</div>
  </section>

  <section id="sizes" class="green band" aria-labelledby="sizes-title">
    <div class="wrap">
      <div class="band-head"><h2 id="sizes-title">Sizes and prices</h2><p>Starting prices. Blush & cream and White & green cost a few pounds more because of the roses.</p></div>
      <div class="size-grid">{sizes.map((size) => <div class="label"><span class="label-name">{size.label}</span><span class="label-price">from <strong>{price(30 + size.extra)}</strong> to {price(35 + size.extra)}</span><p>{size.description}</p></div>)}</div>
    </div>
  </section>

  <section class="wrap section faq-section" aria-labelledby="faq-title"><div class="stack"><h2 id="faq-title">Before you order</h2><p>Short answers to the things people ask most.</p></div><FAQ items={flowerFAQs} /></section>
  <ContactCTA />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-collection-grid] [data-palette]');
  const status = document.querySelector<HTMLElement>('.filter-status');
  buttons.forEach((button) => button.addEventListener('click', () => {
    let visible = 0;
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    cards.forEach((card) => {
      card.hidden = button.dataset.filter !== 'all' && card.dataset.palette !== button.dataset.filter;
      if (!card.hidden) visible++;
    });
    if (status) status.textContent = button.dataset.filter === 'all' ? `Showing all ${visible} palettes.` : `Showing ${button.textContent?.trim()}.`;
  }));
</script>
