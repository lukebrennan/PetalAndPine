---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FAQ from '../../components/FAQ.astro';
import wild from '../../assets/wild.png';
import { collections, flowerFAQs } from '../../data/site';
import { path } from '../../lib/paths';
---
<Layout title="Our flowers — Petal & Pine, Chester" description="Three palettes of loose, garden-style bouquets from Petal & Pine in Chester, each in three sizes." image={wild}>
  <section class="inner-hero wrap"><div><p class="eyebrow">Three palettes</p><h1>Our flowers</h1><p class="page-lead">Three palettes, each in three sizes. Pick the colours you like and we pick the stems that are good that week.</p><a class="text-link" href="#collection">See the palettes</a></div><div class="inner-hero-photo"><Image src={wild} alt="Airy white flowers and garden greenery in a soft green ceramic vase." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <section id="collection" class="wrap section-space">
    <div class="section-heading"><div><p class="eyebrow">Palettes</p><h2>Pick a palette</h2></div><p>The photographs show the colours and the style.<br />Prices are for a small bouquet.</p></div>
    <div class="collection-filters" role="group" aria-label="Filter flower palettes"><button type="button" class="filter-button" data-filter="all" aria-pressed="true">All palettes</button><button type="button" class="filter-button" data-filter="rose" aria-pressed="false">Soft & romantic</button><button type="button" class="filter-button" data-filter="peach" aria-pressed="false">Bright & joyful</button><button type="button" class="filter-button" data-filter="sage" aria-pressed="false">Wild & natural</button></div>
    <p class="filter-status" role="status" aria-live="polite">Showing all 3 palettes.</p>
    <div class="collection-grid" data-collection-grid>{collections.map((collection, index) => <CollectionCard collection={collection} index={index} />)}</div>
  </section>
  <section class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">Not sure which?</p><h2>How to choose</h2></div><a class="text-link" href={path('occasions')}>Browse by occasion</a></div><div class="three-up"><article><span class="step-number">01</span><h3>Start with the person</h3><p>The colours they wear, the colours in their house, a flower they always mention. A favourite colour is the easiest place to start.</p></article><article><span class="step-number">02</span><h3>Then the occasion</h3><p>Soft for a thank-you or sympathy, bright for a birthday, loose and green for a new home. The mood matters as much as the stems.</p></article><article><span class="step-number">03</span><h3>Then the details</h3><p>The date, a rough budget and a card message. Put them in the brief and we will do the rest.</p></article></div></div></section>
  <section class="wrap section-space faq-section"><div><p class="eyebrow">Questions</p><h2>Before you order</h2></div><FAQ items={flowerFAQs} /></section>
  <ContactCTA />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-collection-grid] [data-palette]');
  const status = document.querySelector<HTMLElement>('.filter-status');
  buttons.forEach((button) => button.addEventListener('click', () => {
    let visible = 0;
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    cards.forEach((card) => {
      card.hidden = button.dataset.filter !== 'all' && card.dataset.palette !== button.dataset.filter;
      if (!card.hidden) visible++;
    });
    if (status) status.textContent = button.dataset.filter === 'all' ? `Showing all ${visible} palettes.` : `Showing ${button.textContent?.trim()}.`;
  }));
</script>
