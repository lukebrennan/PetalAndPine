---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FAQ from '../../components/FAQ.astro';
import wild from '../../assets/wild.png';
import { collections, flowerFAQs } from '../../data/site';
import { path } from '../../lib/paths';
---
<Layout title="Our flowers — Petal & Pine" description="Explore soft, joyful, and natural flower palettes, bouquet sizes, and example prices in the Petal & Pine Chester shop preview." image={wild}>
  <section class="inner-hero wrap"><div><p class="eyebrow">Our flowers</p><h1>Find your kind<br />of <em>lovely.</em></h1><p class="page-lead">A soft blush, a joyful burst of colour, or something quietly wild. Start with the feeling, and let a flower palette tell the rest of the story.</p><a class="text-link" href="#collection">Explore the collection</a></div><div class="inner-hero-photo"><Image src={wild} alt="Airy white flowers and garden greenery in a soft green ceramic vase." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" loading="eager" fetchpriority="high" /></div></section>
  <section id="collection" class="wrap section-space">
    <div class="section-heading"><div><p class="eyebrow">The colour stories</p><h2>Three moods.<br /><em>So many little moments.</em></h2></div><p>These photographs are palette inspiration.<br />The prices and sizes are examples for this preview.</p></div>
    <div class="collection-filters" role="group" aria-label="Filter flower palettes"><button type="button" class="filter-button" data-filter="all" aria-pressed="true">All palettes</button><button type="button" class="filter-button" data-filter="rose" aria-pressed="false">Soft & romantic</button><button type="button" class="filter-button" data-filter="peach" aria-pressed="false">Bright & joyful</button><button type="button" class="filter-button" data-filter="sage" aria-pressed="false">Wild & natural</button></div>
    <p class="filter-status" role="status" aria-live="polite">Showing all 3 palettes.</p>
    <div class="collection-grid" data-collection-grid>{collections.map((collection, index) => <CollectionCard collection={collection} index={index} />)}</div>
  </section>
  <section class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">A little help choosing</p><h2>Begin with the <em>person.</em></h2></div><a class="text-link" href={path('occasions')}>Explore occasions</a></div><div class="three-up"><article><span class="step-number">01</span><h3>Their kind of colour</h3><p>Think about the shades they wear, their home, or a colour they always notice. A favourite is a lovely place to begin.</p></article><article><span class="step-number">02</span><h3>The feeling of the gesture</h3><p>Gentle and reassuring? Bright and celebratory? Loose and natural? The mood matters as much as the flowers.</p></article><article><span class="step-number">03</span><h3>A few thoughtful details</h3><p>A preferred date, a simple budget, and a personal message help bring everything together. Add them to your flower brief.</p></article></div></div></section>
  <section class="wrap section-space faq-section"><div><p class="eyebrow">Choosing made simple</p><h2>A little<br /><em>flower knowledge.</em></h2></div><FAQ items={flowerFAQs} /></section>
  <ContactCTA />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-collection-grid] [data-palette]');
  const status = document.querySelector<HTMLElement>('.filter-status');
  buttons.forEach((button) => button.addEventListener('click', () => {
    let visible = 0;
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    cards.forEach((card) => {
      card.hidden = button.dataset.filter !== 'all' && card.dataset.palette !== button.dataset.filter;
      if (!card.hidden) visible++;
    });
    if (status) status.textContent = button.dataset.filter === 'all' ? `Showing all ${visible} palettes.` : `Showing ${button.textContent?.trim()}.`;
  }));
</script>
