---
import Layout from '../layouts/Layout.astro';
import FlowerBrief from '../components/FlowerBrief.astro';
import FAQ from '../components/FAQ.astro';
import { shop, contactFAQs } from '../data/site';
---
<Layout title="Contact — Petal & Pine, Chester" description="Where to find Petal & Pine in Chester, opening hours, delivery, and a form that writes your bouquet brief for you.">
  <section class="wrap page-head"><h1>Contact</h1><p class="lead">Plan a bouquet below and send us the brief, or come in. We are open Tuesday to Saturday.</p></section>

  <section id="flower-brief" class="green section" aria-labelledby="brief-title">
    <div class="wrap"><div class="band-head"><h2 id="brief-title">Plan a bouquet</h2><p>Fill in what you know. The message updates as you go.</p></div><FlowerBrief /></div>
  </section>

  <section class="wrap section" aria-label="Shop details">
    {shop.isDemo && <div class="notice" style="margin-bottom: 28px"><p><strong>Demonstration site.</strong> {shop.demoNote}</p></div>}
    <div class="contact-grid">
      <div><h2>The shop</h2><address>{shop.address.map((line) => <span class="address-line">{line}</span>)}</address><p class="small muted" style="margin-top: 12px">Two minutes from the Eastgate Clock, on the left past the bakery.</p></div>
      <div><h2>Get in touch</h2><div class="detail"><span>Email</span><strong>{shop.email}</strong></div><div class="detail"><span>Phone</span><strong>{shop.phone}</strong></div><p class="small muted" style="margin-top: 16px">Email is best for briefs; phone if it is for today.</p></div>
      <div><h2>Hours and delivery</h2><dl class="hours">{shop.hours.map((hours) => <div><dt>{hours.days}</dt><dd>{hours.time}</dd></div>)}</dl><p style="margin-top: 16px">{shop.delivery}</p></div>
    </div>
  </section>

  <section class="wrap section rule faq-section" aria-labelledby="faq-title"><div class="stack"><h2 id="faq-title">Ordering</h2></div><FAQ items={contactFAQs} /></section>
</Layout>
