---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FlowerBrief from '../components/FlowerBrief.astro';
import FAQ from '../components/FAQ.astro';
import { shop, contactFAQs } from '../data/site';
---
<Layout title="Contact — Petal & Pine, Chester" description="Where to find Petal & Pine in Chester, opening hours, delivery, and a form that writes your bouquet brief for you.">
  <section class="wrap page-intro"><p class="eyebrow">Contact</p><h1>Say hello</h1><p class="page-lead">Plan a bouquet below and send us the brief, or come in. We are open Tuesday to Saturday.</p></section>
  <div class="wrap demo-notice"><Icon kind="flower" /><p><strong>Demonstration site.</strong> The address, contact details, hours, delivery information and prices are placeholders. The brief builder writes a message for you to copy; nothing is sent or booked.</p></div>
  <section class="wrap contact-grid section-space" aria-label="Shop details">
    <article class="contact-card"><p class="eyebrow">Where</p><h2>The shop</h2><address>{shop.address.map((line) => <span class="address-line">{line}</span>)}</address><p class="small-note">Two minutes from the Eastgate Clock.</p><div class="location-illustration" aria-hidden="true"><span class="map-line one"></span><span class="map-line two"></span><span class="map-line three"></span><span class="map-dot"><Icon kind="flower" /></span><strong>Chester</strong><small>City centre</small></div></article>
    <article class="contact-card"><p class="eyebrow">How</p><h2>Get in touch</h2><div class="contact-row"><span>Email</span><strong>{shop.email}</strong></div><div class="contact-row"><span>Phone</span><strong>{shop.phone}</strong></div><p class="small-note">Email is best for briefs; phone if it is for today.</p><a class="text-link" href="#flower-brief">Plan a bouquet <Icon /></a></article>
    <article class="contact-card"><p class="eyebrow">When</p><h2>Opening hours</h2><dl class="hours-list">{shop.hours.map((hours) => <div><dt>{hours.days}</dt><dd>{hours.time}</dd></div>)}</dl><div class="delivery-note"><h3>Collection & local delivery</h3><p>{shop.delivery}</p></div></article>
  </section>
  <section id="flower-brief" class="soft-band"><div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">Plan a bouquet</p><h2>Your flower brief</h2></div><p>Fill in what you know. The message updates as you go;<br />copy it when you are done.</p></div><FlowerBrief /></div></section>
  <section class="wrap section-space faq-section"><div><p class="eyebrow">Questions</p><h2>Ordering</h2></div><FAQ items={contactFAQs} /></section>
</Layout>
