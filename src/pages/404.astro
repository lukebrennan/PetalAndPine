---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { path } from '../lib/paths';
---
<Layout title="Page not found — Petal & Pine" noindex={true}><section class="wrap section-space not-found"><Icon kind="flower" class="contact-star" /><p class="eyebrow">Page not found</p><h1>That page isn’t here</h1><p class="page-lead">It may have moved, or the link may be wrong. Everything on the site is one click from the home page.</p><a class="button" href={path()}>Home <Icon /></a><a class="text-link" href={path('flowers')}>Our flowers</a></section></Layout>
