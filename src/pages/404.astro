---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { path } from '../lib/paths';
---
<Layout title="Page not found — Petal & Pine" noindex={true}><section class="wrap not-found stack"><h1>That page isn’t here</h1><p class="lead">It may have moved, or the link may be wrong. Everything on the site is one click from the home page.</p><div class="actions"><a class="button" href={path()}>Home <Icon /></a><a class="link" href={path('flowers')}>Bouquets</a></div></section></Layout>
