---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FAQ from '../components/FAQ.astro';
import bouquet from '../assets/bouquet.png';
import studio from '../assets/studio.png';
import care from '../assets/care.png';
import { site, collections, occasions, flowerFAQs } from '../data/site';
import { path } from '../lib/paths';
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="little-line" aria-hidden="true"></span>{site.eyebrow}</p><h1 id="hero-title">{site.name}</h1><p class="hero-tagline">{site.tagline}</p><p class="hero-description">{site.introduction}</p><div class="hero-actions"><a class="button" href={path('flowers')}>See our flowers <Icon /></a><a class="text-link" href={path('occasions')}>Browse by occasion</a></div></div>
    <div class="hero-art"><div class="photo-frame"><Image src={bouquet} alt="Blush, cream, and peach flowers gathered with fresh eucalyptus in ivory wrapping." widths={[640, 960, 1440]} sizes="(max-width: 760px) 92vw, 52vw" format="webp" quality={82} loading="eager" fetchpriority="high" /></div><div class="flower-seal" aria-hidden="true"><span>HAND-TIED</span><Icon kind="flower" class="seal-flower" /><span>IN CHESTER</span></div><p class="photo-caption">Blush & cream, our most-asked-for palette.</p></div>
  </section>
  <div class="values-strip"><span>Garden-style bouquets</span><Icon kind="flower" /><span>Hand-tied to order</span><Icon kind="flower" /><span>Delivery around Chester</span></div>

  <section id="flowers" class="wrap section-space">
    <div class="section-heading"><div><p class="eyebrow">Three palettes</p><h2>Our flowers</h2></div><a class="text-link" href={path('flowers')}>See all three <Icon /></a></div>
    <div class="collection-grid">{collections.map((collection, index) => <CollectionCard collection={collection} index={index} />)}</div>
    <p class="section-note">Prices are for a small bouquet. Stems change with the season; the colours stay the same.</p>
  </section>

  <section class="occasions-band">
    <div class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">Occasions</p><h2>Flowers for the occasion</h2></div><p>Birthdays, thank-yous, new homes,<br />or no reason at all.</p></div>
      <div class="occasion-grid">{occasions.slice(0, 4).map((occasion, index) => <a class="occasion-tile" href={`${path('occasions')}#${occasion.value}`}><span class="tile-number">0{index + 1}</span><h3>{occasion.title}</h3><p>{occasion.description}</p><span class="tile-link">See ideas <Icon /></span></a>)}</div>
    </div>
  </section>

  <section id="our-story" class="story-section"><div class="wrap story-inner">
    <div class="editorial-photo arch"><Image src={studio} alt="The workbench in the shop: jugs of flowers, ribbon, wrapping paper and shears." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" quality={80} loading="lazy" /></div>
    <div class="story-copy"><p class="eyebrow">Our story</p><h2>About the shop</h2><p>{site.story}</p><p>We are a small shop in Chester. Everything is made up by hand on the day, wrapped in paper and tied with ribbon.</p><a class="text-link" href={path('our-story')}>More about us <Icon /></a></div>
  </div></section>

  <section class="wrap section-space split-section care-teaser">
    <div><p class="eyebrow">Flower care</p><h2>Looking after your flowers</h2><p class="body-copy">Fresh water, a clean vase and a cool spot will get you most of the way. The care guide covers the rest.</p><ol class="mini-steps"><li><span>01</span>Trim the stems with clean shears.</li><li><span>02</span>Keep leaves above the waterline.</li><li><span>03</span>Refresh the water and find a cool spot.</li></ol><a class="text-link" href={path('flower-care')}>Read the flower-care guide <Icon /></a></div>
    <div class="editorial-photo"><Image src={care} alt="Pink and cream flowers in a glass vase beside floral shears and linen." widths={[640, 960]} sizes="(max-width: 760px) 92vw, 45vw" format="webp" quality={80} loading="lazy" /></div>
  </section>

  <section class="faq-section wrap section-space"><div><p class="eyebrow">Questions</p><h2>Common questions</h2><p class="body-copy">If yours isn’t here, ask when you get in touch.</p></div><FAQ items={flowerFAQs.slice(0, 3)} /></section>
  <div id="contact"><ContactCTA /></div>
</Layout>
