---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FAQ from '../components/FAQ.astro';
import bouquet from '../assets/bouquet.png';
import studio from '../assets/studio.png';
import { site, collections, occasions, flowerFAQs } from '../data/site';
import { path, price } from '../lib/paths';
---
<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy"><h1 id="hero-title">{site.name}</h1><p class="tagline">{site.tagline}</p><p class="lead">{site.introduction}</p><div class="actions"><a class="button" href={`${path('contact')}#flower-brief`}>Plan a bouquet <Icon /></a><a class="link" href={path('flowers')}>See the three palettes</a></div></div>
    <div class="hero-photo"><Image src={bouquet} alt="A loose hand-tied bouquet of blush garden roses, ranunculus and eucalyptus in ivory paper, on a stone bench." widths={[640, 960, 1440, 1800]} sizes="(max-width: 900px) 100vw, 55vw" format="webp" quality={82} loading="eager" fetchpriority="high" /></div>
  </section>

  <section class="green band palettes" aria-label="The three palettes">
    <div class="wrap">
      <div class="labels">{collections.map((collection) => <a class="label" href={path(`flowers/${collection.slug}`)}><span class="label-name">{collection.name}</span><span class="label-price">from <strong>{price(collection.price)}</strong></span><p>{collection.description}</p><span class="label-go">See the palette <Icon /></span></a>)}</div>
      <p class="band-note small">Prices are for a posy. Bouquets from {price(45)}, large bouquets from {price(60)}.</p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how-title">
    <h2 id="how-title" style="margin-bottom: 28px">How it works</h2>
    <div class="panes cols-3 steps">
      <div class="pane"><h3>Pick a palette</h3><p>Blush & cream, Peach & coral or White & green. The photos show the colours and the style; the stems are whatever is best that week.</p></div>
      <div class="pane"><h3>Choose a size</h3><p>A posy from {price(30)}, a bouquet from {price(45)}, a large bouquet from {price(60)}. We confirm the exact price before we make anything.</p></div>
      <div class="pane"><h3>Send us the brief</h3><p>The contact page writes the message for you. Copy it, send it, and we will reply with a date and a price.</p></div>
    </div>
  </section>

  <section class="wrap section rule" aria-labelledby="occasions-title">
    <div class="band-head"><h2 id="occasions-title">What are they for?</h2><a class="link" href={path('occasions')}>All occasions, with card messages <Icon /></a></div>
    <ul class="rows">{occasions.slice(0, 4).map((occasion) => {
      const collection = collections.find((item) => item.slug === occasion.collection)!;
      return <li><h3>{occasion.title}</h3><p>{occasion.idea}</p><a class="link" href={`${path('occasions')}#${occasion.value}`}>{collection.name} <Icon /></a></li>;
    })}</ul>
  </section>

  <section class="wrap section rule split" aria-labelledby="about-title">
    <div class="photo"><Image src={studio} alt="The workbench in the shop: jugs of roses, ranunculus and foliage, a spool of ribbon and a pair of shears." widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={80} loading="lazy" /></div>
    <div class="stack"><h2 id="about-title">A small shop in Chester</h2><p>{site.story}</p><p>Everything is wrapped in paper and tied with ribbon, nothing comes in cellophane, and we will always tell you if what you have asked for is not in season.</p><div class="actions"><a class="link" href={path('our-story')}>About the shop <Icon /></a><a class="link" href={path('flower-care')}>How to keep them going <Icon /></a></div></div>
  </section>

  <section class="wrap section rule faq-section" aria-labelledby="faq-title"><div class="stack"><h2 id="faq-title">Questions people ask</h2><p>If yours is not here, put it in the brief and we will answer it with the quote.</p></div><FAQ items={flowerFAQs.slice(0, 3)} /></section>
  <div id="contact"><ContactCTA /></div>
</Layout>
